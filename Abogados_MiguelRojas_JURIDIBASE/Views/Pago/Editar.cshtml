@model Abogados_MiguelRojas_JURIDIBASE.Models.Pago

@{
    if (User.Identity.IsAuthenticated)
    {
        if (User.IsInRole("Administrador"))
        {
            Layout = "~/Views/Shared/_Layout_Admin.cshtml";
        }
        else if (User.IsInRole("Abogado"))
        {
            Layout = "~/Views/Shared/_Layout.cshtml";
        }
        else if (User.IsInRole("Asistente"))
        {
            Layout = "~/Views/Shared/_LayoutAsistente.cshtml";
        }
    }
    else
    {
        Layout = "~/Views/Shared/Layout_Limpio.cshtml";
    }

    ViewData["Title"] = "Editar Pago";
}

<h1>Editar Pago</h1>

<form asp-action="Editar" asp-route-id="@Model.idPago" method="post">
    <input asp-for="idPago" type="hidden" />

    @if (ViewBag.AbogadoActual != null)
    {
        <input asp-for="idAbogado" type="hidden" value="@ViewBag.AbogadoActual.idAbogado" />
        <div class="form-group mb-3">
            <label>Abogado</label>
            <input class="form-control" value="@ViewBag.AbogadoActual.nombreAbogado @ViewBag.AbogadoActual.apellidoAbogado" readonly />
        </div>
    }
    else
    {
        <div class="form-group mb-3">
            <label asp-for="idAbogado">Abogado</label>
            <select asp-for="idAbogado" class="form-control" asp-items="ViewBag.Abogados"></select>
            <span asp-validation-for="idAbogado" class="text-danger"></span>
        </div>
    }

    <div class="form-group mb-3">
        <label asp-for="idCliente">Cliente</label>
        <select asp-for="idCliente" class="form-control" asp-items="ViewBag.Clientes"></select>
        <span asp-validation-for="idCliente" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="id_Caso">Caso</label>
        <select asp-for="id_Caso" class="form-control" asp-items="ViewBag.Casos"></select>
        <span asp-validation-for="id_Caso" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="metodoPago">Metodo de Pago</label>
        <input asp-for="metodoPago" class="form-control" />
        <span asp-validation-for="metodoPago" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="monto">Monto</label>
        <input asp-for="monto" class="form-control" type="number" step="0.01" min="0" />
        <span asp-validation-for="monto" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="fechaPago">Fecha de Pago</label>
        <input asp-for="fechaPago" class="form-control" type="date" />
        <span asp-validation-for="fechaPago" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Guardar</button>
    <a class="btn btn-secondary" asp-action="Listar">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
