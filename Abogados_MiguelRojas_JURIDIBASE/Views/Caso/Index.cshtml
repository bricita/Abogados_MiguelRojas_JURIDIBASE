@model IEnumerable<Abogados_MiguelRojas_JURIDIBASE.Models.Caso>

@{
    if (User.Identity.IsAuthenticated)
    {

        if (User.IsInRole("Administrador"))
        {
            Layout = "~/Views/Shared/_Layout_Admin.cshtml";
        }
        else if (User.IsInRole("Abogado"))
        {
            Layout = "~/Views/Shared/_Layout.cshtml";
        }
        else if (User.IsInRole("Asistente"))
        {
            Layout = "~/Views/Shared/_LayoutAsistente.cshtml";
        }
    }
    else
    {
        Layout = "~/Views/Shared/Layout_Limpio.cshtml";
    }
    ViewData["Title"] = "Casos";
}

<h1>Casos</h1>

<p>
    <a class="btn btn-primary" asp-action="Create">Nuevo Caso</a>
</p>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Título</th>
            <th>Descripción</th>
            <th>Estado</th>
            <th>Abogado</th>
            <th>Cliente</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="7" class="text-center text-muted py-4">
                    <i class="bi bi-calendar-x fs-4 d-block mb-2"></i>
                    No hay casos registrados en el sistema.
                </td>
            </tr>
        }
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.tituloCaso</td>
                <td>@item.descripcionCaso</td>
                <td>@(item.estadoCaso ? "Activo" : "Cerrado")</td>
                <td>@item.abogado?.nombreAbogado</td>
                <td>@item.cliente?.nombreCliente</td>
                <td>
                    <a class="btn btn-sm btn-info" asp-action="Details" asp-route-id="@item.idCaso">Ver</a>
                    <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@item.idCaso">Editar</a>
                    <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.idCaso">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>