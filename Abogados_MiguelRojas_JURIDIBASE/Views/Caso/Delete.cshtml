@model Abogados_MiguelRojas_JURIDIBASE.Models.Caso

@{
    if (User.Identity.IsAuthenticated)
    {

        if (User.IsInRole("Administrador"))
        {
            Layout = "~/Views/Shared/_Layout_Admin.cshtml";
        }
        else if (User.IsInRole("Abogado"))
        {
            Layout = "~/Views/Shared/_Layout.cshtml";
        }
        else if (User.IsInRole("Asistente"))
        {
            Layout = "~/Views/Shared/_LayoutAsistente.cshtml";
        }
    }
    else
    {
        Layout = "~/Views/Shared/Layout_Limpio.cshtml";
    }
    ViewData["Title"] = "Eliminar Caso";
}

<h1>Eliminar Caso</h1>
<h3>¿Está seguro que desea eliminar este caso?</h3>
<hr />
<dl class="row">
    <dt class="col-sm-2">Título</dt>
    <dd class="col-sm-10">@Model.tituloCaso</dd>

    <dt class="col-sm-2">Abogado</dt>
    <dd class="col-sm-10">@Model.abogado?.nombreAbogado</dd>

    <dt class="col-sm-2">Cliente</dt>
    <dd class="col-sm-10">@Model.cliente?.nombreCliente</dd>
</dl>
<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="idCaso" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a class="btn btn-secondary" asp-action="Index">Cancelar</a>
</form>