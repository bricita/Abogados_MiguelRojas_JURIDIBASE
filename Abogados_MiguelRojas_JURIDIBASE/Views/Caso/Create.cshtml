@model Abogados_MiguelRojas_JURIDIBASE.Models.Caso

@{
    if (User.Identity.IsAuthenticated)
    {

        if (User.IsInRole("Administrador"))
        {
            Layout = "~/Views/Shared/_Layout_Admin.cshtml";
        }
        else if (User.IsInRole("Abogado"))
        {
            Layout = "~/Views/Shared/_Layout.cshtml";
        }
        else if (User.IsInRole("Asistente"))
        {
            Layout = "~/Views/Shared/_LayoutAsistente.cshtml";
        }
    }
    else
    {
        Layout = "~/Views/Shared/Layout_Limpio.cshtml";
    }
    ViewData["Title"] = "Nuevo Caso";
}

<h1>Nuevo Caso</h1>

<form asp-action="Create" method="post">
    <div class="form-group">
        <label class="form-label">Titulo Caso</label>
        <input asp-for="tituloCaso" class="form-control" />
        <span asp-validation-for="tituloCaso" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label class="form-label">Descripcion</label>
        <textarea asp-for="descripcionCaso" class="form-control"></textarea>
        <span asp-validation-for="descripcionCaso" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label class="form-label">Estado</label>
        <input asp-for="estadoCaso" type="checkbox" />
    </div>
    <div class="form-group">
        <label class="form-label">Abogado</label>
        <select asp-for="id_Abogado" asp-items="ViewBag.Abogados" class="form-control">
            <option value="">-- Seleccione un Abogado --</option>
        </select>
        <span asp-validation-for="id_Abogado" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label class="form-label">Cliente</label>
        <select asp-for="id_Cliente" asp-items="ViewBag.Clientes" class="form-control">
            <option value="">-- Seleccione un Cliente --</option>
        </select>
        <span asp-validation-for="id_Cliente" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Guardar</button>
    <a class="btn btn-secondary" asp-action="Index">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
