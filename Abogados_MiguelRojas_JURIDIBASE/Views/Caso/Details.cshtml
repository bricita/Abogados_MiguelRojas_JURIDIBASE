@model Abogados_MiguelRojas_JURIDIBASE.Models.Caso

@{
    ViewData["Title"] = "Detalle del Caso";
}

<h1>Detalle del Caso</h1>
<hr />
<dl class="row">
    <dt class="col-sm-2">Título</dt>
    <dd class="col-sm-10">@Model.tituloCaso</dd>

    <dt class="col-sm-2">Descripción</dt>
    <dd class="col-sm-10">@Model.descripcionCaso</dd>

    <dt class="col-sm-2">Estado</dt>
    <dd class="col-sm-10">@(Model.estadoCaso ? "Activo" : "Cerrado")</dd>

    <dt class="col-sm-2">Abogado</dt>
    <dd class="col-sm-10">@Model.abogado?.nombreAbogado</dd>

    <dt class="col-sm-2">Cliente</dt>
    <dd class="col-sm-10">@Model.cliente?.nombreCliente</dd>
</dl>
<a class="btn btn-warning" asp-action="Edit" asp-route-id="@Model.idCaso">Editar</a>
<a class="btn btn-secondary" asp-action="Index">Volver</a>