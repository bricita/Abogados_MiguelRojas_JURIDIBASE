@model Abogados_MiguelRojas_JURIDIBASE.Models.DocumentosLegales

@{
    ViewData["Title"] = "Agregar Documento";
}

<h1>Agregar Documento</h1>

<form asp-action="Create" method="post">
    <div class="form-group">
        <label asp-for="nombreDocumento"></label>
        <input asp-for="nombreDocumento" class="form-control" />
        <span asp-validation-for="nombreDocumento" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="rutaDocumento"></label>
        <input asp-for="rutaDocumento" class="form-control" />
        <span asp-validation-for="rutaDocumento" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="fechaCreacion"></label>
        <input asp-for="fechaCreacion" type="date" class="form-control" />
        <span asp-validation-for="fechaCreacion" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="id_Expediente">Expediente</label>
        <select asp-for="id_Expediente" class="form-control" asp-items="ViewBag.Expedientes"></select>
    </div>
    <button type="submit" class="btn btn-primary">Guardar</button>
    <a class="btn btn-secondary" asp-action="Index">Cancelar</a>
</form>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
}