@model IEnumerable<Abogados_MiguelRojas_JURIDIBASE.Models.DocumentosLegales>

@{
    if (User.Identity.IsAuthenticated)
    {
        // Usamos los roles exactos definidos en tu switch del Login
        if (User.IsInRole("Administrador"))
        {
            Layout = "~/Views/Shared/_Layout_Admin.cshtml";
        }
        else if (User.IsInRole("Abogado"))
        {
            Layout = "~/Views/Shared/_Layout.cshtml";
        }
        else if (User.IsInRole("Asistente"))
        {
            Layout = "~/Views/Shared/_LayoutAsistente.cshtml";
        }
    }
    else
    {
        Layout = "~/Views/Shared/Layout_Limpio.cshtml";
    }
    ViewData["Title"] = "Documentos Legales";
}

<h1>Documentos Legales</h1>

<p>
    <a class="btn btn-primary" asp-action="Create">Agregar Documento</a>
</p>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Expediente</th>
            <th>Fecha</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="7" class="text-center text-muted py-4">
                    <i class="bi bi-calendar-x fs-4 d-block mb-2"></i>
                    No hay documentos registrados en el sistema.
                </td>
            </tr>
        }
@foreach (var item in Model)
{
    <tr>
        <td>@item.nombreDocumento</td>
        <td>@(item.expediente != null ? item.expediente.tituloExpediente : "-")</td>
        <td>@item.fechaCreacion.ToString()</td>
        <td>
            <a class="btn btn-sm btn-info" asp-action="Details" asp-route-id="@item.idDocumentoLegal">Ver</a>
            <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.idDocumentoLegal">Eliminar</a>
        </td>
    </tr>
}
    </tbody>
</table>