@model Abogados_MiguelRojas_JURIDIBASE.Models.DocumentosLegales

@{
    if (User.Identity.IsAuthenticated)
    {
        if (User.IsInRole("Administrador"))
        {
            Layout = "~/Views/Shared/_Layout_Admin.cshtml";
        }
        else if (User.IsInRole("Abogado"))
        {
            Layout = "~/Views/Shared/_Layout.cshtml";
        }
        else if (User.IsInRole("Asistente"))
        {
            Layout = "~/Views/Shared/_LayoutAsistente.cshtml";
        }
    }
    else
    {
        Layout = "~/Views/Shared/Layout_Limpio.cshtml";
    }
    ViewData["Title"] = "Detalle Documento";
}

<h1>Detalle Documento</h1>

<div>
    <h4>Documento</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Nombre</dt>
        <dd class="col-sm-10">@Model.nombreDocumento</dd>

        <dt class="col-sm-2">Fecha</dt>
        <dd class="col-sm-10">@Model.fechaCreacion.ToString()</dd>

        <dt class="col-sm-2">Expediente</dt>
        <dd class="col-sm-10">@(Model.expediente != null ? Model.expediente.tituloExpediente : "-")</dd>
    </dl>
</div>

<div class="mb-3">
    <a class="btn btn-success" asp-action="VerPdf" asp-route-id="@Model.idDocumentoLegal" target="_blank">Abrir PDF</a>
    <a class="btn btn-secondary" asp-action="Index">Volver</a>
</div>

@if (!string.IsNullOrEmpty(Model.rutaDocumento))
{
    <hr />
    <h5>Vista previa del PDF</h5>
    <iframe src="@Url.Action("VerPdf", new { id = Model.idDocumentoLegal })" style="width:100%;height:600px;border:1px solid #ccc;"></iframe>
}
