@model IEnumerable<Abogados_MiguelRojas_JURIDIBASE.Models.AreaDerecho>

@{
    if (User.Identity.IsAuthenticated)
    {

        if (User.IsInRole("Administrador"))
        {
            Layout = "~/Views/Shared/_Layout_Admin.cshtml";
        }
        else if (User.IsInRole("Abogado"))
        {
            Layout = "~/Views/Shared/_Layout.cshtml";
        }
        else if (User.IsInRole("Asistente"))
        {
            Layout = "~/Views/Shared/_LayoutAsistente.cshtml";
        }
    }
    else
    {
        Layout = "~/Views/Shared/Layout_Limpio.cshtml";
    }
    ViewData["Title"] = "Áreas de Derecho";
}

<h1>Áreas de Derecho</h1>

<p>
    <a class="btn btn-primary" asp-action="Create">Nueva Área</a>
</p>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Descripción</th>
            <th>Estado</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.nombreAreaDerecho</td>
                <td>@item.descripcionAreaDerecho</td>
                <td>@(item.estadoAreaDerecho ? "Activo" : "Inactivo")</td>
                <td>
                    <a class="btn btn-sm btn-info" asp-action="Details" asp-route-id="@item.idAreaDerecho">Ver</a>
                    <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@item.idAreaDerecho">Editar</a>
                    <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.idAreaDerecho">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>