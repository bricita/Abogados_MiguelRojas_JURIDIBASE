@model IEnumerable<Abogados_MiguelRojas_JURIDIBASE.Models.AreaDerecho>
@{
    ViewData["Title"] = "Áreas de Derecho";
    Layout = "~/Views/Shared/_Layout_Admin.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Áreas de Derecho</h1>
    <a asp-action="Create" class="btn btn-juridico"><i class="bi bi-plus-lg"></i> Nueva Área</a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr><th>Nombre</th><th>Descripción</th><th>Estado</th><th class="text-end">Acciones</th></tr>
            </thead>
            <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <td>@a.nombreAreaDerecho</td>
                        <td>@a.descripcionAreaDerecho</td>
                        <td><span class="badge @(a.estadoAreaDerecho ? "bg-success" : "bg-secondary")">@(a.estadoAreaDerecho ? "Activo" : "Inactivo")</span></td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@a.idAreaDerecho" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                            <a asp-action="Delete" asp-route-id="@a.idAreaDerecho" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
