@model Abogados_MiguelRojas_JURIDIBASE.Models.AreaDerecho
@{ ViewData["Title"] = "Editar Área de Derecho"; Layout = "~/Views/Shared/_Layout_Admin.cshtml"; }

<h1>Editar Área de Derecho</h1>
<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="idAreaDerecho" />
    <div class="mb-3">
        <label asp-for="nombreAreaDerecho" class="form-label"></label>
        <input asp-for="nombreAreaDerecho" class="form-control" />
        <span asp-validation-for="nombreAreaDerecho" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="descripcionAreaDerecho" class="form-label"></label>
        <textarea asp-for="descripcionAreaDerecho" class="form-control"></textarea>
        <span asp-validation-for="descripcionAreaDerecho" class="text-danger"></span>
    </div>
    <div class="mb-3 form-check">
        <input asp-for="estadoAreaDerecho" class="form-check-input" />
        <label asp-for="estadoAreaDerecho" class="form-check-label"></label>
    </div>
    <button type="submit" class="btn btn-juridico">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
@section Scripts{ <partial name="_ValidationScriptsPartial" /> }
