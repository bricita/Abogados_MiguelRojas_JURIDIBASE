@model Abogados_MiguelRojas_JURIDIBASE.Models.AreaDerecho

@{
    ViewData["Title"] = "Eliminar Área de Derecho";
}

<h1>Eliminar Área de Derecho</h1>
<h3>¿Está seguro que desea eliminar esta área?</h3>
<hr />
<dl class="row">
    <dt class="col-sm-2">Nombre</dt>
    <dd class="col-sm-10">@Model.nombreAreaDerecho</dd>

    <dt class="col-sm-2">Descripción</dt>
    <dd class="col-sm-10">@Model.descripcionAreaDerecho</dd>

    <dt class="col-sm-2">Estado</dt>
    <dd class="col-sm-10">@(Model.estadoAreaDerecho ? "Activo" : "Inactivo")</dd>
</dl>
<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="idAreaDerecho" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a class="btn btn-secondary" asp-action="Index">Cancelar</a>
</form>