@model Abogados_MiguelRojas_JURIDIBASE.Models.AreaDerecho

@{
    ViewData["Title"] = "Detalle Área de Derecho";
}

<h1>Detalle Área de Derecho</h1>
<hr />
<dl class="row">
    <dt class="col-sm-2">Nombre</dt>
    <dd class="col-sm-10">@Model.nombreAreaDerecho</dd>

    <dt class="col-sm-2">Descripción</dt>
    <dd class="col-sm-10">@Model.descripcionAreaDerecho</dd>

    <dt class="col-sm-2">Estado</dt>
    <dd class="col-sm-10">@(Model.estadoAreaDerecho ? "Activo" : "Inactivo")</dd>
</dl>
<a class="btn btn-warning" asp-action="Edit" asp-route-id="@Model.idAreaDerecho">Editar</a>
<a class="btn btn-secondary" asp-action="Index">Volver</a>