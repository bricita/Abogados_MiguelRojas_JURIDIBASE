@model Abogados_MiguelRojas_JURIDIBASE.Models.AreaDerecho

@{
    if (User.Identity.IsAuthenticated)
    {

        if (User.IsInRole("Administrador"))
        {
            Layout = "~/Views/Shared/_Layout_Admin.cshtml";
        }
        else if (User.IsInRole("Abogado"))
        {
            Layout = "~/Views/Shared/_Layout.cshtml";
        }
        else if (User.IsInRole("Asistente"))
        {
            Layout = "~/Views/Shared/_LayoutAsistente.cshtml";
        }
    }
    else
    {
        Layout = "~/Views/Shared/Layout_Limpio.cshtml";
    }
    ViewData["Title"] = "Nueva Área de Derecho";
}

<h1>Nueva Área de Derecho</h1>

<form asp-action="Create" method="post">
    <div class="form-group">
        <label asp-for="nombreAreaDerecho"></label>
        <input asp-for="nombreAreaDerecho" class="form-control" />
        <span asp-validation-for="nombreAreaDerecho" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="descripcionAreaDerecho"></label>
        <textarea asp-for="descripcionAreaDerecho" class="form-control"></textarea>
        <span asp-validation-for="descripcionAreaDerecho" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="estadoAreaDerecho"></label>
        <input asp-for="estadoAreaDerecho" type="checkbox" />
    </div>
    <button type="submit" class="btn btn-primary">Guardar</button>
    <a class="btn btn-secondary" asp-action="Index">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}