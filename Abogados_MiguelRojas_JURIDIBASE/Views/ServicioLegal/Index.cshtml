@model IEnumerable<Abogados_MiguelRojas_JURIDIBASE.Models.ServicioLegal>
@{
    ViewData["Title"] = "Servicios Legales";
    Layout = "~/Views/Shared/_Layout_Admin.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Servicios Legales</h1>
    <a asp-action="Create" class="btn btn-juridico"><i class="bi bi-plus-lg"></i> Nuevo Servicio</a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr><th>Nombre</th><th>Descripción</th><th>Costo Base</th><th>Estado</th><th class="text-end">Acciones</th></tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td>@s.nombreServicio</td>
                        <td>@s.descripcionServicio</td>
                        <td>S/ @s.costoBase.ToString("N2")</td>
                        <td><span class="badge bg-info text-dark">@s.estadoServicio</span></td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@s.idServicio" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                            <a asp-action="Delete" asp-route-id="@s.idServicio" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
