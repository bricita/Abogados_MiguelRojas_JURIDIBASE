@model Abogados_MiguelRojas_JURIDIBASE.Models.Cita

@{
    Layout = "_Layout";
}
@{
    ViewData["Title"] = "Detalle de Cita";
}

<h1>Detalle de Cita</h1>

<div>
    <h4>Cita</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Asunto</dt>
        <dd class="col-sm-10">@Model.asuntoLegalCita</dd>

        <dt class="col-sm-2">Detalles</dt>
        <dd class="col-sm-10">@Model.detallesAdicionalesCita</dd>

        <dt class="col-sm-2">Fecha</dt>
        <dd class="col-sm-10">@Model.fechaHoraCita.ToString()</dd>

        <dt class="col-sm-2">Abogado</dt>
        <dd class="col-sm-10">@(Model.abogado != null ? Model.abogado.nombreAbogado : "-")</dd>

        <dt class="col-sm-2">Cliente</dt>
        <dd class="col-sm-10">@(Model.cliente != null ? Model.cliente.nombreCliente : "-")</dd>

        <dt class="col-sm-2">Estado</dt>
        <dd class="col-sm-10">@(Model.estadoCita ? "Activa" : "Inactiva")</dd>
    </dl>
</div>

<p>
    <a class="btn btn-secondary" href="@Url.Action("Index")">Volver</a>
</p>