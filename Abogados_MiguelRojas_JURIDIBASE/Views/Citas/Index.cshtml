@model IEnumerable<Abogados_MiguelRojas_JURIDIBASE.Models.Cita>

@{
    if (User.Identity.IsAuthenticated)
    {
        if (User.IsInRole("Administrador"))
        {
            Layout = "~/Views/Shared/_Layout_Admin.cshtml";
        }
        else if (User.IsInRole("Abogado"))
        {
            Layout = "~/Views/Shared/_Layout.cshtml";
        }
        else if (User.IsInRole("Asistente"))
        {
            Layout = "~/Views/Shared/_LayoutAsistente.cshtml";
        }
    }
    else
    {
        Layout = null;
    }

    ViewData["Title"] = "Agenda de Citas";
}

<h1>Agenda de Citas</h1>

<p>
    <!-- Redirige a 'Create' según los métodos de tu controlador -->
    <a class="btn btn-primary" asp-controller="Citas" asp-action="Create">
        <i class="bi bi-calendar-plus me-1"></i> Nueva Cita
    </a>
</p>

<!-- Control de alertas del TempData puesto en tu CitasController -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Fecha</th>
            <th>Cliente</th>
            <th>Abogado Asignado</th>
            <th>Asunto Legal</th>
            <th>Detalles</th>
            <th>Estado</th>
            <th>Opciones</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="7" class="text-center text-muted py-4">
                    <i class="bi bi-calendar-x fs-4 d-block mb-2"></i>
                    No hay citas programadas en el sistema.
                </td>
            </tr>
        }
        else
        {
            @foreach (var item in Model)
            {
                <tr>
                    <!-- Propiedad del modelo: fechaHoraCita -->
                    <td class="fw-semibold">
                        @item.fechaHoraCita.ToString("dd/MM/yyyy")
                    </td>
                    <!-- Navegación: cliente.nombreCliente -->
                    <td>
                        @(item.cliente != null ? item.cliente.nombreCliente : "No asignado")
                    </td>
                    <!-- Navegación: abogado.nombreAbogado y apellidoAbogado -->
                    <td>
                        @if (item.abogado != null)
                        {
                            <span>@item.abogado.nombreAbogado @item.abogado.apellidoAbogado</span>
                        }
                        else
                        {
                            <span class="text-muted">Por asignar</span>
                        }
                    </td>
                    <!-- Propiedad: asuntoLegalCita -->
                    <td>
                        <span class="text-truncate d-inline-block" style="max-width: 200px;" title="@item.asuntoLegalCita">
                            @item.asuntoLegalCita
                        </span>
                    </td>
                    <!-- Propiedad: detallesAdicionalesCita -->
                    <td>
                        <span class="text-muted text-truncate d-inline-block" style="max-width: 250px;" title="@item.detallesAdicionalesCita">
                            @item.detallesAdicionalesCita
                        </span>
                    </td>
                    <!-- Propiedad: estadoCita (Boolean) -->
                    <td>
                        @if (item.estadoCita)
                        {
                            <span class="badge bg-success"><i class="bi bi-calendar-check me-1"></i> Confirmada</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary"><i class="bi bi-clock-history me-1"></i> Pendiente</span>
                        }
                    </td>
                    <!-- Acciones alineadas con las rutas GET del controlador -->
                    <td>
                        <div class="d-flex gap-1">
                            <a class="btn btn-sm btn-info" asp-action="Details" asp-route-id="@item.idCita" title="Ver Detalles">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@item.idCita" title="Editar">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.idCita" title="Eliminar">
                                <i class="bi bi-trash"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>