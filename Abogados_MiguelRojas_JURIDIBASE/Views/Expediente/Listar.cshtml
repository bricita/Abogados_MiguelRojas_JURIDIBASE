@model IEnumerable<Abogados_MiguelRojas_JURIDIBASE.Models.Expediente>

@{
    if (User.Identity.IsAuthenticated)
    {
        // Usamos los roles exactos definidos en tu switch del Login
        if (User.IsInRole("Administrador"))
        {
            Layout = "~/Views/Shared/_Layout_Admin.cshtml";
        }
        else if (User.IsInRole("Abogado"))
        {
            Layout = "~/Views/Shared/_Layout.cshtml";
        }
        else if (User.IsInRole("Asistente"))
        {
            Layout = "~/Views/Shared/_LayoutAsistente.cshtml";
        }
    }
    else
    {
        Layout = "~/Views/Shared/Layout_Limpio.cshtml";
    }
    ViewData["Title"] = "Expedientes";
}

<h1>Gestión de Expedientes</h1>

<p>
    <a asp-action="Nuevo" class="btn btn-primary">Nuevo Expediente</a>
</p>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>ID</th>
            <th>Título</th>
            <th>Tipo</th>
            <th>Víctima</th>
            <th>Victimario</th>
            <th>Fechas</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.idExpediente</td>
                <td>@item.tituloExpediente</td>
                <td>@item.tipoExpediente</td>
                <td>@item.victima</td>
                <td>@item.victimario</td>
                <td>@item.fechaInicio - @item.fechaCierre</td>
                <td>
                    <span class="badge @(item.estadoExpediente ? "bg-success" : "bg-warning text-dark")">
                        @(item.estadoExpediente ? "Activo" : "Cerrado")
                    </span>
                </td>
                <td>
                    <a asp-action="Editar" asp-route-id="@item.idExpediente" class="btn btn-sm btn-warning">Editar</a>
                    <a asp-action="Eliminar" asp-route-id="@item.idExpediente" class="btn btn-sm btn-danger" onclick="return confirm('¿Eliminar expediente?');">Eliminar</a>
                </td>
            </tr>
