@model Abogados_MiguelRojas_JURIDIBASE.Models.Expediente

@{
    if (User.Identity.IsAuthenticated)
    {
        if (User.IsInRole("Administrador"))
        {
            Layout = "~/Views/Shared/_Layout_Admin.cshtml";
        }
        else if (User.IsInRole("Abogado"))
        {
            Layout = "~/Views/Shared/_Layout.cshtml";
        }
        else if (User.IsInRole("Asistente"))
        {
            Layout = "~/Views/Shared/_LayoutAsistente.cshtml";
        }
    }
    else
    {
        Layout = "~/Views/Shared/Layout_Limpio.cshtml";
    }
    ViewData["Title"] = "Nuevo Expediente";
}

<h1>Nuevo Expediente</h1>

<form asp-action="Nuevo" method="post">
    <div class="form-group">
        <label class="form-label">Título del Expediente</label>
        <input asp-for="tituloExpediente" class="form-control" required maxlength="70" />
        <span asp-validation-for="tituloExpediente" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label class="form-label">Tipo de Expediente</label>
        <input asp-for="tipoExpediente" class="form-control" required maxlength="70" />
        <span asp-validation-for="tipoExpediente" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label class="form-label">Resumen del Expediente</label>
        <textarea asp-for="resumenExpediente" class="form-control" rows="3" required maxlength="200"></textarea>
        <span asp-validation-for="resumenExpediente" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label class="form-label">Víctima</label>
        <input asp-for="victima" class="form-control" required maxlength="20" />
        <span asp-validation-for="victima" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label class="form-label">Victimario</label>
        <input asp-for="victimario" class="form-control" required maxlength="20" />
        <span asp-validation-for="victimario" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label class="form-label">Fecha de Inicio</label>
        <input asp-for="fechaInicio" class="form-control" type="date" required maxlength="10" />
        <span asp-validation-for="fechaInicio" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label class="form-label">Fecha de Cierre</label>
        <input asp-for="fechaCierre" class="form-control" type="date" required maxlength="10" />
        <span asp-validation-for="fechaCierre" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label class="form-label">Estado</label>
        <select asp-for="estadoExpediente" class="form-control">
            <option value="true">Activo</option>
            <option value="false">Cerrado</option>
        </select>
        <span asp-validation-for="estadoExpediente" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label class="form-label">ID Caso Asociado</label>
        <input asp-for="id_Caso" class="form-control" type="number" required />
        <span asp-validation-for="id_Caso" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Guardar</button>
    <a class="btn btn-secondary" asp-action="Listar">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
