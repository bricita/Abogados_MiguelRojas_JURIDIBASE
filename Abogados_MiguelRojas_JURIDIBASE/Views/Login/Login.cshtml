@model Abogados_MiguelRojas_JURIDIBASE.ViewModels.LoginVM

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar Sesión - JURIDIBASE</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <style>
            /* Paleta de colores idéntica al Layout */
            :root {
                --deep-dark-blue: #1B263B;
                --solid-grey-blue: #415A77;
                --blanco-humo: #F8F9FA;
                --gris-oxford: #415A77;
                --gris-acero: #E0E1DD;
            }

            body {
                /* Degradado sutil usando los tonos azulados de la paleta */
                background: linear-gradient(135deg, #415A77 0%, var(--deep-dark-blue) 100%);
                height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            }

            .login-card {
                background: #ffffff;
                border: none;
                border-radius: 12px;
                box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
                overflow: hidden;
            }

            .login-header {
                background-color: var(--deep-dark-blue); /* Colores principales del Layout */
                color: #f1f5f9;
                text-align: center;
                padding: 2.5rem 1.5rem 1.5rem 1.5rem;
                border-bottom: 3px solid var(--gris-acero); /* División limpia */
            }

            .brand-title {
                font-size: 1.6rem;
                font-weight: 700;
                letter-spacing: 1px;
                margin-bottom: 0.2rem;
                text-transform: uppercase;
            }

            .brand-subtitle {
                font-size: 0.85rem;
                color: #94a3b8;
                font-weight: 400;
            }

            /* Enfoque de inputs usando Solid Grey-Blue */
            .form-control:focus {
                border-color: var(--solid-grey-blue);
                box-shadow: 0 0 0 0.25rem rgba(65, 90, 119, 0.25);
            }

            /* Botón institucional */
            .btn-legal {
                background-color: var(--deep-dark-blue);
                color: #ffffff;
                border: 1px solid var(--deep-dark-blue);
                font-weight: 600;
                transition: all 0.3s ease;
            }

                .btn-legal:hover {
                    background-color: var(--solid-grey-blue); /* Pasa al segundo azul principal */
                    border-color: var(--solid-grey-blue);
                    color: #ffffff;
                }

            .form-label {
                color: var(--gris-oxford);
                font-weight: 500;
                font-size: 0.9rem;
            }

            /* Enlace inferior estilizado */
            .register-link {
                color: var(--solid-grey-blue);
                text-decoration: none;
                font-weight: 600;
                transition: color 0.2s;
            }

                .register-link:hover {
                    color: var(--deep-dark-blue);
                    text-decoration: underline;
                }
    </style>
</head>
<body>

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-sm-8 col-md-6 col-lg-4">

                <div class="card login-card">
                    <div class="login-header">
                        <div class="brand-title">JURIDIBASE</div>
                        <div class="brand-subtitle">Estudio Jurídico Miguel Rojas & Asociados</div>
                    </div>

                    <div class="card-body p-4">
                        <form asp-controller="Login" asp-action="Login" method="post" autocomplete="off">

                            <div class="mb-3">
                                <label class="form-label" asp-for="NombreUser">Usuario o Identificación</label>
                                <input class="form-control" type="text" placeholder="Ej: mrojas" required asp-for="NombreUser" />
                                <span asp-validation-for="NombreUser" class="text-danger small"></span>
                            </div>

                            <div class="mb-4">
                                <label class="form-label" asp-for="Password">Contraseña del Sistema</label>
                                <input class="form-control" type="password" placeholder="••••••••" required asp-for="Password" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <div class="d-grid gap-2 mb-3">
                                <button class="btn btn-legal py-2" type="submit">Ingresar al Portal</button>
                            </div>
                        </form>

                        @if (ViewData["Mensaje"] != null)
                        {
                            <div class="alert alert-danger py-2 text-center small my-3" role="alert">
                                <strong>Error:</strong> @ViewData["Mensaje"]
                            </div>
                        }

                        <!-- Enlace de registro mejor alineado y con los estilos del sistema -->
                        <div class="text-center mt-3 small text-muted">
                            ¿No tienes una cuenta? <a asp-controller="Usuario" asp-action="Nuevo" asp-route-publico="true" class="register-link">Regístrate aquí</a>
                        </div>
                    </div>

                    <div class="card-footer bg-light text-center py-2" style="border-top: 1px solid var(--gris-acero);">
                        <small class="text-muted" style="font-size: 0.75rem;">Sistema Interno Protegido &copy; 2026</small>
                    </div>
                </div>

            </div>
        </div>
    </div>
</body>
</html>
