@model IEnumerable<Abogados_MiguelRojas_JURIDIBASE.Models.Notificacion>

@{
    ViewData["Title"] = "Notificaciones";
}

<h1>Notificaciones</h1>

<p>
    <a asp-action="Nuevo" class="btn btn-primary">Crear Notificación</a>
</p>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>ID</th>
            <th>Título</th>
            <th>Mensaje</th>
            <th>Fecha</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @* 1. Validamos si la lista viene vacía desde el servidor *@
        @if (!Model.Any())
        {
            <tr>
                <td colspan="6" class="text-center text-muted py-4">
                    <i class="bi bi-bell-slash fs-4 d-block mb-2"></i>
                    No hay notificaciones registradas en el sistema.
                </td>
            </tr>
        }
        else
        {
            @* 2. Un solo ciclo controlado para renderizar las filas *@
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.idNotificacion</td>
                    <td>@item.tituloNotificacion</td>
                    <td>
                        @if (item.mensajeNotificacion != null)
                        {
                            @(item.mensajeNotificacion.Length > 50 ? item.mensajeNotificacion.Substring(0, 50) + "..." : item.mensajeNotificacion)
                        }
                        else
                        {
                            <span class="text-muted">Sin mensaje</span>
                        }
                    </td>
                    <td>@item.fechaNotificacion.ToString("dd/MM/yyyy")</td>
                    <td>
                        <span class="badge @(item.leido ? "bg-secondary" : "bg-success")">
                            @(item.leido ? "Leído" : "No Leído")
                        </span>
                    </td>
                    <td>
                        <a asp-action="Editar" asp-route-id="@item.idNotificacion" class="btn btn-sm btn-warning">Editar</a>
                        <a asp-action="Eliminar" asp-route-id="@item.idNotificacion" class="btn btn-sm btn-danger" onclick="return confirm('¿Seguro que desea eliminar esta notificación?');">Eliminar</a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>