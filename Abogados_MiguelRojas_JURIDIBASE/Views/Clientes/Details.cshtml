@model Abogados_MiguelRojas_JURIDIBASE.Models.Cliente

@{
    if (User.Identity.IsAuthenticated)
    {
        // Usamos los roles exactos definidos en tu switch del Login
        if (User.IsInRole("Admin"))
        {
            Layout = "~/Views/Shared/_Layout_Admin.cshtml";
        }
        else if (User.IsInRole("Abogado"))
        {
            Layout = "~/Views/Shared/_Layout.cshtml";
        }
        else if (User.IsInRole("Asistente"))
        {
            Layout = "~/Views/Shared/_LayoutAsistente.cshtml";
        }
    }
    else
    {
        Layout = "~/Views/Shared/Layout_Limpio.cshtml";
    }
    ViewData["Title"] = "Detalle Cliente";
}

<h1>Detalle de Cliente</h1>

<div class="mb-3">
    <a class="btn btn-secondary" asp-action="Index">Volver</a>
    <a class="btn btn-success" asp-controller="Pago" asp-action="Nuevo" asp-route-clienteId="@Model.idCliente">Registrar Pago</a>
    <a class="btn btn-outline-success" asp-controller="Pago" asp-action="Listar" asp-route-clienteId="@Model.idCliente">Ver Pagos</a>
</div>

<dl class="row">
    <dt class="col-sm-3">Nombre</dt>
    <dd class="col-sm-9">@Model.nombreCliente</dd>

    <dt class="col-sm-3">Descripcion</dt>
    <dd class="col-sm-9">@Model.descripcionCliente</dd>

    <dt class="col-sm-3">DNI</dt>
    <dd class="col-sm-9">@Model.dniCliente</dd>

    <dt class="col-sm-3">RUC</dt>
    <dd class="col-sm-9">@Model.rucCliente</dd>

    <dt class="col-sm-3">Telefono</dt>
    <dd class="col-sm-9">@Model.telefonoCliente</dd>

    <dt class="col-sm-3">Direccion</dt>
    <dd class="col-sm-9">@Model.direccionCliente</dd>

    <dt class="col-sm-3">Correo</dt>
    <dd class="col-sm-9">@Model.correoCliente</dd>

    <dt class="col-sm-3">Abogado</dt>
    <dd class="col-sm-9">@(Model.abogado != null ? $"{Model.abogado.nombreAbogado} {Model.abogado.apellidoAbogado}" : "Sin abogado")</dd>

    <dt class="col-sm-3">Estado</dt>
    <dd class="col-sm-9">@(Model.estadoCliente ? "Activo" : "Inactivo")</dd>

    <dt class="col-sm-3">Tipo</dt>
    <dd class="col-sm-9">@Model.tipoCliente</dd>
</dl>

<h4 class="mt-4">Pagos del Cliente</h4>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Fecha</th>
            <th>Metodo</th>
            <th>Monto</th>
            <th>Caso</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.pago != null && Model.pago.Any())
        {
            foreach (var pago in Model.pago.OrderByDescending(p => p.fechaPago))
            {
                <tr>
                    <td>@pago.fechaPago</td>
                    <td>@pago.metodoPago</td>
                    <td>@pago.monto.ToString("N2")</td>
                    <td>@(pago.caso?.tituloCaso ?? "Sin caso")</td>
                    <td>
                        <a class="btn btn-sm btn-info" asp-controller="Pago" asp-action="Detalles" asp-route-id="@pago.idPago">Ver</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="5" class="text-muted">No hay pagos registrados para este cliente.</td>
            </tr>
        }
    </tbody>
</table>
