@model Abogados_MiguelRojas_JURIDIBASE.Models.Cliente

@{
    ViewData["Title"] = "Detalle Cliente";
}

<h1>Detalle Cliente</h1>

<div>
    <h4>Cliente</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Nombre</dt>
        <dd class="col-sm-10">@Model.nombreCliente</dd>

        <dt class="col-sm-2">Descripción</dt>
        <dd class="col-sm-10">@Model.descripcionCliente</dd>

        <dt class="col-sm-2">DNI</dt>
        <dd class="col-sm-10">@Model.dniCliente</dd>

        <dt class="col-sm-2">Teléfono</dt>
        <dd class="col-sm-10">@Model.telefonoCliente</dd>

        <dt class="col-sm-2">Correo</dt>
        <dd class="col-sm-10">@Model.correoCliente</dd>
    </dl>
</div>

<p>
    <a class="btn btn-secondary" asp-action="Index">Volver</a>
</p>