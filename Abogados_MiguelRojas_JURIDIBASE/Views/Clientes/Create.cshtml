@model Abogados_MiguelRojas_JURIDIBASE.Models.Cliente


@{
    Layout = "_Layout";
}
@{
    ViewData["Title"] = "Nuevo Cliente";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 col-lg-6">

            <h5 class="mb-0">Registro de Nuevo Usuario</h5>

            <form asp-action="Create" method="post" autocomplete="off">

                <div class="mb-3">
                    <label asp-for="nombreCliente" class="form-label">Nombre</label>
                    <input asp-for="nombreCliente" class="form-control" placeholder="Nombre completo" />
                    <span asp-validation-for="nombreCliente" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="descripcionCliente" class="form-label">Descripción</label>
                    <textarea asp-for="descripcionCliente" class="form-control" rows="3" placeholder="Detalles o notas del cliente..."></textarea>
                    <span asp-validation-for="descripcionCliente" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="dniCliente" class="form-label">DNI</label>
                    <input asp-for="dniCliente" class="form-control" placeholder="Número de documento" />
                    <span asp-validation-for="dniCliente" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="telefonoCliente" class="form-label">Teléfono</label>
                    <input asp-for="telefonoCliente" class="form-control" placeholder="Ej: 987654321" />
                    <span asp-validation-for="telefonoCliente" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="correoCliente" class="form-label">Correo</label>
                    <input asp-for="correoCliente" type="email" class="form-control" placeholder="ejemplo@correo.com" />
                    <span asp-validation-for="correoCliente" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="direccionCliente" class="form-label">Dirección</label>
                    <input asp-for="direccionCliente" class="form-control" placeholder="Dirección domiciliaria" />
                    <span asp-validation-for="direccionCliente" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="tipoCliente" class="form-label">Tipo de Cliente</label>
                    <input asp-for="tipoCliente" class="form-control" placeholder="Ej: Frecuente, Corporativo, etc." />
                    <span asp-validation-for="tipoCliente" class="text-danger"></span>
                </div>

                <div class="mb-4 form-check">
                    <input asp-for="estadoCliente" type="checkbox" class="form-check-input" id="estadoClienteCheck" />
                    <label class="form-check-label" for="estadoClienteCheck">Cliente Activo</label>
                    <span asp-validation-for="estadoCliente" class="text-danger"></span>
                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-primary me-2">Guardar</button>
                    <a class="btn btn-secondary" asp-action="Index">Cancelar</a>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}