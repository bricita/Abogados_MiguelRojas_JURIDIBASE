@model Abogados_MiguelRojas_JURIDIBASE.Models.Cliente

@{
    if (User.Identity.IsAuthenticated)
    {
        // Usamos los roles exactos definidos en tu switch del Login
        if (User.IsInRole("Admin"))
        {
            Layout = "~/Views/Shared/_Layout_Admin.cshtml";
        }
        else if (User.IsInRole("Abogado"))
        {
            Layout = "~/Views/Shared/_Layout.cshtml";
        }
        else if (User.IsInRole("Asistente"))
        {
            Layout = "~/Views/Shared/_LayoutAsistente.cshtml";
        }
    }
    else
    {
        Layout = "~/Views/Shared/Layout_Limpio.cshtml";
    }

    ViewData["Title"] = "Registro de Nuevo Cliente";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 col-lg-6">

            <h1 class="mb-4">Nuevo Cliente</h1>

            <form asp-action="Create" method="post" autocomplete="off">

                <div class="mb-3">
                    <label class="form-label">Nombre Completo</label>
                    <input asp-for="nombreCliente" class="form-control" placeholder="Ej: Juan Pérez Díaz" required />
                    <span asp-validation-for="nombreCliente" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label>Descripción</label>
                    <textarea class="form-control" asp-for="descripcionCliente"></textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label">DNI / Documento de Identidad</label>
                    <input asp-for="dniCliente" class="form-control" placeholder="Número de documento de 8 dígitos" required />
                    <span asp-validation-for="dniCliente" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label>RUC</label>
                    <input class="form-control" type="text" asp-for="rucCliente" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Teléfono</label>
                    <input asp-for="telefonoCliente" class="form-control" placeholder="Ej: 987654321" required />
                    <span asp-validation-for="telefonoCliente" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Correo Electrónico</label>
                    <input asp-for="correoCliente" type="email" class="form-control" placeholder="ejemplo@correo.com" required />
                    <span asp-validation-for="correoCliente" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Dirección Domiciliaria</label>
                    <input asp-for="direccionCliente" class="form-control" placeholder="Ej: Av. Larco 123 - Trujillo" required />
                    <span asp-validation-for="direccionCliente" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Tipo de Cliente</label>
                    <input asp-for="tipoCliente" class="form-control" placeholder="Ej: Regular, Corporativo, Preferencial" required />
                    <span asp-validation-for="tipoCliente" class="text-danger"></span>
                </div>

                @if (ViewBag.AbogadoActual != null)
                {
                    <input asp-for="idAbogado" type="hidden" value="@ViewBag.AbogadoActual.idAbogado" />
                    <div class="mb-3">
                        <label class="form-label">Abogado Asignado</label>
                        <input class="form-control" value="@ViewBag.AbogadoActual.nombreAbogado @ViewBag.AbogadoActual.apellidoAbogado" readonly />
                    </div>
                }
                else
                {
                    <div class="mb-3">
                        <label class="form-label">Asignar Abogado Patrocinador</label>
                        <select asp-for="idAbogado" class="form-select" asp-items="ViewBag.Abogados" required>
                            <option value="" selected disabled>Seleccione un Abogado</option>
                        </select>
                        <span asp-validation-for="idAbogado" class="text-danger"></span>
                    </div>
                }

                <!-- Checkbox de Estado -->
                <div class="mb-4 form-check">
                    <input asp-for="estadoCliente" type="checkbox" class="form-check-input" id="estadoClienteCheck" />
                    <label class="form-check-label" for="estadoClienteCheck">Cliente Activo</label>
                    <span asp-validation-for="estadoCliente" class="text-danger"></span>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary me-2">Guardar</button>
                    <a class="btn btn-secondary" asp-action="Index">Cancelar</a>
                </div>

            </form>

            @if (ViewData["Mensaje"] != null)
            {
                <div class="alert alert-danger mt-3" role="alert">
                    @ViewData["Mensaje"]
                </div>
            }

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}