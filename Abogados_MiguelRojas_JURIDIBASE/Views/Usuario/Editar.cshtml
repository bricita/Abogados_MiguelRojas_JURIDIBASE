@model Abogados_MiguelRojas_JURIDIBASE.Models.Usuario;
@{
    if (User.Identity.IsAuthenticated)
    {
        // Usamos los roles exactos definidos en tu switch del Login
        if (User.IsInRole("Admin"))
        {
            Layout = "~/Views/Shared/_Layout_Admin.cshtml";
        }
        else if (User.IsInRole("Abogado"))
        {
            Layout = "~/Views/Shared/_Layout.cshtml";
        }
        else if (User.IsInRole("Asistente"))
        {
            Layout = "~/Views/Shared/_LayoutAsistente.cshtml";
        }
    }
    else
    {
        Layout = "~/Views/Shared/Layout_Limpio.cshtml";
    }
}
<div>
    <div class="col-sm-8 offset-1-sm-2">
        <h2>Editar Usuario</h2>
        <form asp-controller="Usuario" asp-action="Editar" method="post">
            <input asp-for="idUsuario" type="hidden" />
            <div class="mb-3">
                <label>Nombre Usuario</label>
                <input class="form-control" type="text" asp-for="nombreUsuario" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Rol del Usuario</label>
                <select class="form-select" required asp-for="rolUsuario">
                    <option value="">Seleccione un Rol</option>
                    <option value="Admin">Administrador</option>
                    <option value="Abogado">Abogado</option>
                    <option value="Asistente">Asistente</option>
                </select>
                <span asp-validation-for="rolUsuario" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label>Contraseña</label>
                <input class="form-control" type="text" asp-for="passwordUsuario" required />
            </div>

            <div class="mb-3">
                <button class="btn btn-success" type="submit">Guardar</button>
            </div>
        </form>
    </div>
</div>