@model Abogados_MiguelRojas_JURIDIBASE.Models.Usuario;
<div>
    <div class="col-sm-8 offset-1-sm-2">
        <h2>Editar Usuario</h2>
        <form asp-controller="Usuario" asp-action="Editar" method="post">
            <input asp-for="idUsuario" type="hidden" />
            <div class="mb-3">
                <label>Nombre Usuario</label>
                <input class="form-control" type="text" asp-for="nombreUsuario" required />
            </div>
            <div class="mb-3">
                <label>Rol</label>
                <input class="form-control" type="email" asp-for="rolUsuario" required />
            </div>
            <div class="mb-3">
                <button class="btn btn-success" type="submit">Guardar</button>
            </div>
        </form>
    </div>
</div>