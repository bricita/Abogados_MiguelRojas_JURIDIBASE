@model Abogados_MiguelRojas_JURIDIBASE.Models.Usuario

@{
    if (User.Identity.IsAuthenticated)
    {
        if (User.IsInRole("Administrador"))
        {
            Layout = "~/Views/Shared/_Layout_Admin.cshtml";
        }
        else if (User.IsInRole("Abogado"))
        {
            Layout = "~/Views/Shared/_Layout.cshtml";
        }
        else if (User.IsInRole("Asistente"))
        {
            Layout = "~/Views/Shared/_LayoutAsistente.cshtml";
        }
    }
    else
    {
        Layout = "~/Views/Shared/Layout_Limpio.cshtml";
    }

    ViewData["Title"] = "Editar Usuario";
}

<div class="container mt-4">
    <div class="col-sm-8 offset-sm-2">
        <h2 class="mb-4 text-secondary-juridico">Editar Usuario</h2>

        <form asp-controller="Usuario" asp-action="Editar" method="post" autocomplete="off">
            <input asp-for="idUsuario" type="hidden" />

            <div class="mb-3">
                <label class="form-label fw-semibold">Nombre de Usuario</label>
                <input class="form-control border-juridico" type="text" asp-for="nombreUsuario" required />
                <span asp-validation-for="nombreUsuario" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Rol del Usuario</label>
                <select class="form-select border-juridico" asp-for="RolId" asp-items="ViewBag.Roles" required>
                    <option value="" disabled>-- Seleccione un Rol --</option>
                </select>
                <span asp-validation-for="RolId" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold">Contraseña</label>
                <input class="form-control border-juridico" type="text" asp-for="passwordUsuario" required />
                <span asp-validation-for="passwordUsuario" class="text-danger small"></span>
            </div>

            <div class="d-flex gap-2">
                <button class="btn btn-success px-4" type="submit">
                    <i class="bi bi-floppy me-1"></i> Guardar Cambios
                </button>
                <a class="btn btn-secondary px-4" asp-action="Listar">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
