@model IEnumerable<Abogados_MiguelRojas_JURIDIBASE.Models.Audiencia>

@{
    if (User.Identity.IsAuthenticated)
    {

        if (User.IsInRole("Administrador"))
        {
            Layout = "~/Views/Shared/_Layout_Admin.cshtml";
        }
        else if (User.IsInRole("Abogado"))
        {
            Layout = "~/Views/Shared/_Layout.cshtml";
        }
        else if (User.IsInRole("Asistente"))
        {
            Layout = "~/Views/Shared/_LayoutAsistente.cshtml";
        }
    }
    else
    {
        Layout = "~/Views/Shared/Layout_Limpio.cshtml";
    }
    ViewData["Title"] = "Audiencias";
}

<h1>Audiencias</h1>

<p>
    <a class="btn btn-primary" asp-action="Create">Nueva Audiencia</a>
</p>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Dirección</th>
            <th>Tipo</th>
            <th>Fecha</th>
            <th>Hora</th>
            <th>Abogado</th>
            <th>Caso</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="7" class="text-center text-muted py-4">
                    <i class="bi bi-calendar-x fs-4 d-block mb-2"></i>
                    No hay audiencias registradas en el sistema.
                </td>
            </tr>
        }
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.direccionAudiencia</td>
                <td>@item.tipoAudiencia</td>
                <td>@item.fechaAudiencia.ToString("dd/MM/yyyy")</td>
                <td>@item.horaAudiencia.ToString("HH:mm")</td>
                <td>@item.abogado?.nombreAbogado</td>
                <td>@item.caso?.tituloCaso</td>
                <td>
                    <a class="btn btn-sm btn-info" asp-action="Details" asp-route-id="@item.idAudiencia">Ver</a>
                    <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@item.idAudiencia">Editar</a>
                    <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.idAudiencia">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>