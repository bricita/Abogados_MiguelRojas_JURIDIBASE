@model Abogados_MiguelRojas_JURIDIBASE.Models.Especialista

@{
    if (User.Identity.IsAuthenticated)
    {
        if (User.IsInRole("Administrador"))
        {
            Layout = "~/Views/Shared/_Layout_Admin.cshtml";
        }
        else if (User.IsInRole("Abogado"))
        {
            Layout = "~/Views/Shared/_Layout.cshtml";
        }
        else if (User.IsInRole("Asistente"))
        {
            Layout = "~/Views/Shared/_LayoutAsistente.cshtml";
        }
    }
    else
    {
        Layout = "~/Views/Shared/Layout_Limpio.cshtml";
    }
    ViewData["Title"] = "Nuevo Especialista";
}

<h1>Nuevo Especialista</h1>

<form asp-action="Nuevo" method="post">
    <div class="form-group">
        <label class="form-label">Nombre Completo</label>
        <input asp-for="nombreEspecialista" class="form-control" placeholder="Ingresar nombre completo" required />
        <span asp-validation-for="nombreEspecialista" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label class="form-label">DNI</label>
        <input asp-for="dniEspecialista" class="form-control" placeholder="Ingresar DNI" required />
        <span asp-validation-for="dniEspecialista" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label class="form-label">Estado</label>
        <select asp-for="estadoEspecialista" class="form-control">
            <option value="Activo">Activo</option>
            <option value="Inactivo">Inactivo</option>
        </select>
        <span asp-validation-for="estadoEspecialista" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label class="form-label">Teléfono</label>
        <input asp-for="telefonoEspecialista" class="form-control" placeholder="Ingresar teléfono" required />
        <span asp-validation-for="telefonoEspecialista" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label class="form-label">Disponibilidad</label><br />
        <input asp-for="disponibilidadEspecialista" type="checkbox" /> Disponible
    </div>

    <div class="form-group">
        <label class="form-label">Correo Electrónico</label>
        <input asp-for="correoEspecialista" type="email" class="form-control" placeholder="Ingresar correo electrónico" required />
        <span asp-validation-for="correoEspecialista" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label class="form-label">Descripción / Perfil</label>
        <textarea asp-for="descripcionEspecialista" class="form-control" rows="3" placeholder="Ingresar descripción" required></textarea>
        <span asp-validation-for="descripcionEspecialista" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Guardar Especialista</button>
    <a class="btn btn-secondary" asp-action="Listar">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
