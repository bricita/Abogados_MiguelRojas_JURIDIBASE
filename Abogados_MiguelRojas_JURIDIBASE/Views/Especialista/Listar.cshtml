@model IEnumerable<Abogados_MiguelRojas_JURIDIBASE.Models.Especialista>

@{
    if (User.Identity.IsAuthenticated)
    {
        if (User.IsInRole("Administrador"))
        {
            Layout = "~/Views/Shared/_Layout_Admin.cshtml";
        }
        else if (User.IsInRole("Abogado"))
        {
            Layout = "~/Views/Shared/_Layout.cshtml";
        }
        else if (User.IsInRole("Asistente"))
        {
            Layout = "~/Views/Shared/_LayoutAsistente.cshtml";
        }
    }
    else
    {
        Layout = "~/Views/Shared/Layout_Limpio.cshtml";
    }
    ViewData["Title"] = "Especialistas";
}

<div class="container mt-4">
    <div class="mb-4">
        <h2>Gestión de Especialistas</h2>
        <a asp-action="Nuevo" class="btn btn-primary mt-2">Nuevo Especialista</a>
    </div>

    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>DNI</th>
                <th>Teléfono</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">
                        <i class="bi bi-calendar-x fs-4 d-block mb-2"></i>
                        No hay pagos registrados en el sistema.
                    </td>
                </tr>
            }
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.idEspecialista</td>
                    <td>@item.nombreEspecialista</td>
                    <td>@item.dniEspecialista</td>
                    <td>@item.telefonoEspecialista</td>
                    <td>
                        <span class="badge @(item.estadoEspecialista == "Activo" ? "bg-success" : "bg-secondary")">
                            @item.estadoEspecialista
                        </span>
                    </td>
                    <td>
                        <a asp-action="Editar" asp-route-id="@item.idEspecialista" class="btn btn-sm btn-warning">Editar</a>
                        <a asp-action="Eliminar" asp-route-id="@item.idEspecialista" class="btn btn-sm btn-danger" onclick="return confirm('¿Está seguro de eliminar este especialista?');">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>