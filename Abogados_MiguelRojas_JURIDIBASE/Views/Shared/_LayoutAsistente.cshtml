<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - JURIDIBASE (Asistente)</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
            :root {
                --deep-dark-blue: #1B263B;
                --solid-grey-blue: #415A77;
                --blanco-humo: #F8F9FA;
                --gris-oxford: #415A77;
                --gris-acero: #E0E1DD;
                --alerta-cita: #778DA9;
                --urgencia: #A44A3F;
                --asistente-tag: #6c757d;
            }

            body {
                background-color: var(--blanco-humo);
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                overflow-x: hidden;
            }

            .wrapper {
                display: flex;
                align-items: stretch;
                height: 100vh;
            }

            #sidebar {
                min-width: 260px;
                max-width: 260px;
                background-color: var(--deep-dark-blue);
                color: #ffffff;
                transition: all 0.3s;
                display: flex;
                flex-direction: column;
                border-right: 1px solid var(--gris-acero);
            }

                #sidebar .sidebar-header {
                    padding: 20px;
                    background-color: #111926;
                    border-bottom: 2px solid var(--gris-acero);
                    text-align: center;
                }

                    #sidebar .sidebar-header h3 {
                        font-size: 1.4rem;
                        font-weight: 700;
                        letter-spacing: 1px;
                        margin: 0;
                        color: #ffffff;
                    }

                #sidebar ul.components {
                    padding: 15px 0;
                    flex-grow: 1;
                }

                #sidebar ul li {
                    padding: 2px 15px;
                }

                    #sidebar ul li a {
                        padding: 12px 15px;
                        font-size: 0.95rem;
                        color: #e2e8f0;
                        display: flex;
                        align-items: center;
                        gap: 12px;
                        text-decoration: none;
                        border-radius: 6px;
                        transition: all 0.2s ease;
                    }

                        #sidebar ul li a i {
                            font-size: 1.2rem;
                        }

                        #sidebar ul li a:hover {
                            background-color: var(--solid-grey-blue);
                            color: #ffffff;
                        }

                    #sidebar ul li.active > a {
                        background-color: var(--solid-grey-blue);
                        color: #ffffff;
                        font-weight: 600;
                    }

            .sidebar-footer {
                padding: 15px 20px;
                border-top: 1px solid rgba(224, 225, 221, 0.1);
                background-color: #111926;
            }

                .sidebar-footer a {
                    color: #fca5a5;
                    text-decoration: none;
                    display: flex;
                    align-items: center;
                    gap: 10px;
                    font-size: 0.9rem;
                }

                    .sidebar-footer a:hover {
                        color: #ef4444;
                    }

            #content {
                width: 100%;
                overflow-y: auto;
                display: flex;
                flex-direction: column;
            }

            .top-navbar {
                background-color: #ffffff;
                padding: 15px 30px;
                border-bottom: 1px solid var(--gris-acero);
                display: flex;
                justify-content: flex-end;
                align-items: center;
            }

            .main-container {
                padding: 30px;
                flex-grow: 1;
            }

            .text-secondary-juridico {
                color: var(--gris-oxford);
            }

            .border-juridico {
                border-color: var(--gris-acero);
            }

            .badge-cita {
                background-color: var(--alerta-cita);
                color: white;
            }

            .badge-urgente {
                background-color: var(--urgencia);
                color: white;
            }

            .btn-juridico {
                background-color: var(--deep-dark-blue);
                color: white;
                border: none;
            }

                .btn-juridico:hover {
                    background-color: var(--solid-grey-blue);
                    color: white;
                }
    </style>
</head>
<body>

    <div class="wrapper">
        <nav id="sidebar">
            <div class="sidebar-header">
                <h3>JURIDIBASE</h3>
                <small class="text-muted" style="font-size: 0.75rem;">Módulo de Asistencia</small>
            </div>

            <ul class="list-unstyled components">
                <li>
                    <a asp-controller="Home" asp-action="Index">
                        <i class="bi bi-house-door-fill"></i> Inicio
                    </a>
                </li>
                <li>
                    <a asp-controller="Clientes" asp-action="Index">
                        <i class="bi bi-people-fill"></i> Control de Clientes
                    </a>
                </li>
                <li>
                    <a asp-controller="Citas" asp-action="Index">
                        <i class="bi bi-calendar3"></i> Agenda de Citas
                    </a>
                </li>
                <li>
                    <a asp-controller="Pago" asp-action="Listar">
                        <i class="bi bi-cash-coin"></i> Registro de Pagos
                    </a>
                </li>
                <li>
                    <a asp-controller="Caso" asp-action="Index">
                        <i class="bi bi-folder-fill"></i> Expedientes y Casos
                    </a>
                </li>
                <li>
                    <a asp-controller="Notificacion" asp-action="Index">
                        <i class="bi bi-bell-fill"></i> Avisos Procesales
                    </a>
                </li>
            </ul>

            <div class="sidebar-footer">
                <a asp-controller="Login" asp-action="Logout">
                    <i class="bi bi-box-arrow-left"></i> Cerrar Sesión
                </a>
            </div>
        </nav>

        <div id="content">
            <div class="top-navbar">
                <form asp-controller="Home" asp-action="Buscar" method="get" class="d-flex align-items-center gap-2 me-auto" style="max-width:400px;flex:1;">
                    <div class="input-group input-group-sm">
                        <input type="text" name="q" class="form-control" placeholder="Buscar casos, clientes, expedientes..." value="@Context.Request.Query["q"]" />
                        <button class="btn btn-outline-secondary" type="submit"><i class="bi bi-search"></i></button>
                    </div>
                </form>
                <div class="d-flex align-items-center gap-3">
                    <div class="dropdown" id="notifDropdown">
                        <button class="btn btn-sm position-relative" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="background:none;border:none;">
                            <i class="bi bi-bell fs-5 text-secondary-juridico"></i>
                            <span id="notifBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size:0.6rem;display:none;">0</span>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end shadow-sm" style="width:360px;max-height:480px;overflow-y:auto;">
                            <div class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom">
                                <h6 class="mb-0 fw-semibold">Notificaciones</h6>
                                <button id="marcarTodoLeido" class="btn btn-sm btn-link text-decoration-none p-0">Marcar todo leído</button>
                            </div>
                            <div id="notifList"><div class="text-center text-secondary py-3"><small>Cargando...</small></div></div>
                        </div>
                    </div>
                    <div class="user-profile d-flex align-items-center gap-2">
                        <i class="bi bi-person-badge-fill fs-5 text-secondary-juridico"></i>
                        <div class="d-flex flex-column text-end">
                            <span class="small fw-semibold text-secondary-juridico" style="line-height: 1.1;">
                                @User.Identity?.Name
                            </span>
                            <span class="text-muted" style="font-size: 0.7rem; font-weight: 500;">
                                Asistente de Despacho
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="main-container">
                @RenderBody()
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        function cargarNotificaciones() {
            $.get('@Url.Action("ObtenerNotificaciones", "Notificacion")', function (data) {
                var badge = $('#notifBadge');
                var list = $('#notifList');
                if (data.noLeidas > 0) {
                    badge.text(data.noLeidas).show();
                } else {
                    badge.hide();
                }
                if (data.items.length === 0) {
                    list.html('<div class="text-center text-secondary py-3"><small>Sin notificaciones</small></div>');
                    return;
                }
                var html = '';
                $.each(data.items, function (i, n) {
                    html += '<div class="dropdown-item' + (n.leido ? '' : ' fw-semibold bg-light') + '" style="white-space:normal;cursor:pointer;" data-id="' + n.idNotificacion + '">';
                    html += '<div class="d-flex justify-content-between"><small class="fw-bold">' + n.tituloNotificacion + '</small><small class="text-muted">' + n.fecha + '</small></div>';
                    html += '<small class="text-secondary">' + n.mensajeNotificacion + '</small>';
                    html += '</div>';
                });
                list.html(html);
                list.find('.dropdown-item').on('click', function () {
                    var id = $(this).data('id');
                    $.post('@Url.Action("MarcarLeido", "Notificacion")', { id: id }, function () {
                        cargarNotificaciones();
                    });
                });
            });
        }
        $(document).ready(function () {
            cargarNotificaciones();
            setInterval(cargarNotificaciones, 30000);
            $('#marcarTodoLeido').on('click', function () {
                $.post('@Url.Action("MarcarTodoLeido", "Notificacion")', function () {
                    cargarNotificaciones();
                });
            });
        });
    </script>
</body>
</html>
