<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - JURIDIBASE</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
            :root {
                --deep-dark-blue: #1B263B;
                --solid-grey-blue: #415A77;
                --blanco-humo: #F8F9FA;
                --gris-oxford: #415A77;
                --gris-acero: #E0E1DD;
            }

            body {
                background-color: var(--blanco-humo);
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                overflow-x: hidden;
            }

            .wrapper {
                display: flex;
                align-items: stretch;
                height: 100vh;
            }

            /* --- SIDEBAR BLOQUEADO --- */
            #sidebar {
                min-width: 260px;
                max-width: 260px;
                background-color: var(--deep-dark-blue);
                color: #ffffff;
                display: flex;
                flex-direction: column;
                border-right: 1px solid var(--gris-acero);
                /* Opacidad sutil para dar la sensación visual de estar deshabilitado */
                opacity: 0.85;
            }

                #sidebar .sidebar-header {
                    padding: 20px;
                    background-color: #111926;
                    border-bottom: 2px solid var(--gris-acero);
                    text-align: center;
                }

                    #sidebar .sidebar-header h3 {
                        font-size: 1.4rem;
                        font-weight: 700;
                        letter-spacing: 1px;
                        margin: 0;
                        color: #ffffff;
                    }

                #sidebar ul.components {
                    padding: 15px 0;
                    flex-grow: 1;
                }

                #sidebar ul li {
                    padding: 2px 15px;
                }

                    /* Estilo para los enlaces bloqueados */
                    #sidebar ul li a.disabled-link {
                        padding: 12px 15px;
                        font-size: 0.95rem;
                        color: #94a3b8 !important; /* Texto opaco/gris */
                        display: flex;
                        align-items: center;
                        gap: 12px;
                        text-decoration: none;
                        cursor: not-allowed; /* Cambia el cursor a un símbolo de prohibido */
                        pointer-events: none; /* Desactiva la acción de clic por completo */
                    }

            /* --- CONTENIDO PRINCIPAL --- */
            #content {
                width: 100%;
                overflow-y: auto;
                display: flex;
                flex-direction: column;
            }

            .top-navbar {
                background-color: #ffffff;
                padding: 15px 30px;
                border-bottom: 1px solid var(--gris-acero);
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

            .main-container {
                padding: 30px;
                flex-grow: 1;
            }
    </style>
</head>
<body>

    <div class="wrapper">
        <!-- BARRA LATERAL BLOQUEADA -->
        <nav id="sidebar">
            <div class="sidebar-header">
                <h3>JURIDIBASE</h3>
                <small class="text-muted" style="font-size: 0.75rem;">Estudio Miguel Rojas</small>
            </div>

            <!-- Los enlaces no tienen atributos asp-controller ni asp-action, y están bloqueados por CSS -->
            <ul class="list-unstyled components">
                <li>
                    <a class="disabled-link">
                        <i class="bi bi-house-door"></i> Inicio 
                    </a>
                </li>
                <li>
                    <a class="disabled-link">
                        <i class="bi bi-people"></i> Clientes 
                    </a>
                </li>
                <li>
                    <a class="disabled-link">
                        <i class="bi bi-calendar3"></i> Agenda de Citas
                    </a>
                </li>
                <li>
                    <a class="disabled-link">
                        <i class="bi bi-person-gear"></i> Control de Usuarios 
                    </a>
                </li>
            </ul>
        </nav>

        <!-- AREA DE TRABAJO DEL FORMULARIO -->
        <div id="content">
            <div class="top-navbar">
                
                <div class="user-profile d-flex align-items-center gap-2">
                    <i class="bi bi-person-circle fs-5 text-muted"></i>
                    <span class="small fw-semibold text-muted">Invitado</span>
                </div>
            </div>

            <div class="main-container">
                @RenderBody()
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>