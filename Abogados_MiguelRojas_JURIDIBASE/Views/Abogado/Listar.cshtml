@model IEnumerable<Abogados_MiguelRojas_JURIDIBASE.Models.Abogado>

@{
    if (User.Identity.IsAuthenticated)
    {
        if (User.IsInRole("Administrador"))
        {
            Layout = "~/Views/Shared/_Layout_Admin.cshtml";
        }
        else if (User.IsInRole("Abogado"))
        {
            Layout = "~/Views/Shared/_Layout.cshtml";
        }
        else if (User.IsInRole("Asistente"))
        {
            Layout = "~/Views/Shared/_LayoutAsistente.cshtml";
        }
    }
    else
    {
        Layout = null;
    }

    ViewData["Title"] = "Agenda de Citas";
}

<h1>Agenda de Citas</h1>

<p>
    <a class="btn btn-primary" asp-controller="Abogado" asp-action="Nuevo">
        <i class="bi bi-calendar-plus me-1"></i> Nuevo Abogado
    </a>
</p>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nombre Completo</th>
            <th>Teléfono</th>
            <th>DNI</th>
            <th>Correo Electrónico</th>
            <th>Especialidad</th>
            <th>Estado</th>
            <th>Opciones</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="7" class="text-center text-muted py-4">
                    <i class="bi bi-calendar-x fs-4 d-block mb-2"></i>
                    No hay abogados registrados en el sistema.
                </td>
            </tr>
        }
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.idAbogado</td>
                <td>@item.nombreAbogado @item.apellidoAbogado</td>
                <td>@item.telefonoAbogado</td>
                <td>@item.dniAbogado</td>
                <td>@item.correoAbogado</td>
                <td>@item.especialidadAbogado</td>
                <td>
                    @if (item.estadoAbogado)
                    {
                        <span class="badge bg-success">Activo</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactivo</span>
                    }
                </td>
                <td>
                    <a class="btn btn-sm btn-info" asp-controller="Abogado" asp-action="Perfil" asp-route-id="@item.idAbogado"><i class="bi bi-person"></i></a>
                    <a class="btn btn-sm btn-warning" asp-controller="Abogado" asp-action="Editar" asp-route-id="@item.idAbogado"><i class="bi bi-pencil"></i></a>
                    <a class="btn btn-sm btn-danger" asp-controller="Abogado" asp-action="Eliminar" asp-route-id="@item.idAbogado" onclick="return confirmar()"><i class="bi bi-trash"></i></a>
                </td>
            </tr>
        }
    </tbody>
</table>
@section Scripts {
    <script>
        function confirmar() {
            return confirm("¿Está seguro de que desea eliminar este abogado?");
        }
    </script>
}
