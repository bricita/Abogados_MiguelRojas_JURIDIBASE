@model Abogados_MiguelRojas_JURIDIBASE.Models.Abogado;
@{
    if (User.Identity.IsAuthenticated)
    {
        if (User.IsInRole("Administrador"))
        {
            Layout = "~/Views/Shared/_Layout_Admin.cshtml";
        }
        else if (User.IsInRole("Abogado"))
        {
            Layout = "~/Views/Shared/_Layout.cshtml";
        }
        else if (User.IsInRole("Asistente"))
        {
            Layout = "~/Views/Shared/_LayoutAsistente.cshtml";
        }
    }
    else
    {
        Layout = "~/Views/Shared/Layout_Limpio.cshtml";
    }
}
<div>
    <div class=" col-sm-8 offset-sm-2">
        <h2> Registro de Abogado</h2>
        <form asp-controller="Abogado" asp-action="Editar" method="post">
            <input type="hidden" asp-for="idAbogado" />
            <div class="mb-3">
                <label>Nombres</label>
                <input class="form-control" type="text" asp-for="nombreAbogado" required />
                <span asp-validation-for="nombreAbogado" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label>Apellidos</label>
                <input class="form-control" type="text" asp-for="apellidoAbogado" required />
                <span asp-validation-for="apellidoAbogado" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label>Teléfono</label>
                <input class="form-control" type="text" asp-for="telefonoAbogado" required />
                <span asp-validation-for="telefonoAbogado" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label>DNI</label>
                <input class="form-control" type="text" asp-for="dniAbogado" required />
                <span asp-validation-for="dniAbogado" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label>Correo</label>
                <input class="form-control" type="email" asp-for="correoAbogado" required />
                <span asp-validation-for="correoAbogado" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label>Especialidad</label>
                <input class="form-control" type="text" asp-for="especialidadAbogado" required />
                <span asp-validation-for="especialidadAbogado" class="text-danger"></span>
            </div>

            <div class="mb-3 form-check">
                <input class="form-check-input" type="checkbox" asp-for="estadoAbogado" id="chkActivo" />
                <label class="form-check-label" for="chkActivo">Activo</label>
            </div>
            <div class="mb-3">
                <button class="btn btn-success" type="submit">
                    Guardar
                </button>
            </div>
            <a asp-controller="Abogado" asp-action="Listar" class="btn btn-danger">Volver</a>
        </form>
    </div>
</div>

@section Scripts{ <partial name="_ValidationScriptsPartial" /> }
